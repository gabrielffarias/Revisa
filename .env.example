# Neon (Dashboard → Connection Details → string "pooled")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Texto aleatório longo para assinar a sessão (ex.: openssl rand -base64 32)
AUTH_SECRET=

# Deixe "true" só enquanto quiser permitir novos cadastros. Se vazio, só o primeiro usuário consegue se cadastrar.
ALLOW_SIGNUP=

# consultadeplaca.net → painel de desenvolvedor. cdp_test_... para testar (placas TST0001, TST0002, TST0003)
CONSULTA_PLACA_KEY=

# Google AI Studio (aistudio.google.com/apikey) — gera o plano de manutenção e lê o manual
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
